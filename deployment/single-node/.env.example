AUDORIX_IMAGE=audorix-objectstorage:0.1.0-rc.2
AUDORIX_BIND_ADDRESS=127.0.0.1
AUDORIX_PORT=5195
AUDORIX_DEPLOYMENT_ID=replace-with-stable-environment-id
AUDORIX_POSTGRES_CONNECTION=Host=postgres;Port=5432;Database=audorix;Username=audorix_runtime;Password=EXTERNAL_SECRET;Maximum Pool Size=16;Timeout=15;Command Timeout=30
AUDORIX_POSTGRES_SCHEMA=audorix_single_node
AUDORIX_BUCKET=files
AUDORIX_S3_ACCESS_KEY=EXTERNAL_SECRET
AUDORIX_S3_SECRET_KEY=EXTERNAL_SECRET
AUDORIX_S3_TOKEN_KEY=EXTERNAL_SECRET_AT_LEAST_32_BYTES
AUDORIX_OPERATIONS_TOKEN=EXTERNAL_SECRET
AUDORIX_ALLOWED_HOSTS=localhost;127.0.0.1
# TLS profile only: path is mounted read-only and password remains external.
AUDORIX_TLS_CERTIFICATE_PATH=/run/secrets/audorix-server.pfx
AUDORIX_TLS_CERTIFICATE_HOST_PATH=./secrets/audorix-server.pfx
AUDORIX_TLS_CERTIFICATE_PASSWORD=EXTERNAL_SECRET
