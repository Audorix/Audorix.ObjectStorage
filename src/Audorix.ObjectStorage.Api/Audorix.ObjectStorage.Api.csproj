<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <PackageId>Audorix.ObjectStorage.Api</PackageId>
    <Title>Audorix Object Storage Authenticated API</Title>
    <Description>Authenticated browse, metadata, download, view, range, and HEAD endpoints for Audorix.ObjectStorage.</Description>
    <PackageTags>object-storage;aspnetcore;api;authorization</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Audorix.ObjectStorage\Audorix.ObjectStorage.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\package-readmes\Audorix.ObjectStorage.Api.md" Pack="true" PackagePath="README.md" />
    <None Include="..\..\THIRD_PARTY_NOTICES.md" Pack="true" PackagePath="THIRD_PARTY_NOTICES.md" />
  </ItemGroup>

</Project>
